{
  "name": "subpilot-client",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:android": "node scripts/build-android.mjs",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && node scripts/build-debug-apk.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@lucide/vue": "^1.17.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.21.0",
    "element-plus": "2.14.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.44",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.4.5",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "baseline-browser-mapping": "2.11.34",
    "browserslist": "4.29.5",
    "follow-redirects": "1.16.2",
    "glob": "14.0.3",
    "minimatch": "11.0.4",
    "postcss-selector-parser": "6.1.5",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
