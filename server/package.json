{
  "name": "subpilot-server",
  "version": "1.0.0",
  "description": "SubPilot - 订阅管理系统后端",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:workers": "wrangler dev",
    "build": "tsc",
    "typecheck:workers": "tsc -p tsconfig.workers.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:d1": "wrangler d1 execute subpilot --file=migrations/0001_init.sql",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "hono": "^4.12.34",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "esbuild": "0.28.1",
    "undici": "7.29.0"
  }
}
